{
  "name": "frianbud",
  "version": "0.1.0",
  "description": "MCP server for Norwegian public procurement (TED + Doffin)",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "frianbud": "dist/index.js" },
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "files": ["dist", "data", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:doffin": "vitest run tests/sources/doffin.live.test.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "env-paths": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "eslint": "^10.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.0"
  }
}
